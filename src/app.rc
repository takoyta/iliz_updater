#include "appinfo.h"

1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION    UPD_VER_MAJOR,UPD_VER_MINOR,UPD_VER_PATCH,0
PRODUCTVERSION UPD_VER_MAJOR,UPD_VER_MINOR,UPD_VER_PATCH,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x1L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      UPD_COMPANY_A "\0"
            VALUE "FileDescription",  UPD_DESC_A "\0"
            VALUE "FileVersion",      UPD_VERSION_A "\0"
            VALUE "InternalName",     UPD_INTERNAL_A "\0"
            VALUE "LegalCopyright",   UPD_COPYRIGHT_A "\0"
            VALUE "OriginalFilename", UPD_EXE_A "\0"
            VALUE "ProductName",      UPD_NAME_A "\0"
            VALUE "ProductVersion",   UPD_VERSION_A "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
